# MongoDB configuration
MONGODB_URL=mongodb://localhost:27017

# LiteLLM connection
LITELLM_SERVER_URL=
LITELLM_API_KEY=

# Evaluation configuration
EVALUATION_MODEL=anthropic/claude-opus-4-8
EVALUATION_MAX_TOKENS=60000
# EVALUATION_TEMPERATURE=0.0  # Used for non-thinking models; ignored for claude-opus-4-8

# Deduplication configuration
DEDUPLICATION_MODEL=gemini/gemini-3.5-flash
DEDUPLICATION_MAX_TOKENS=65536
DEDUPLICATION_THINKING_LEVEL=high  # Used for gemini-3.5-flash; ignored for other models
# DEDUPLICATION_TEMPERATURE=0.0  # Used for non-thinking models; ignored for gemini-3.5-flash

# Application settings
DEBUG=true
LOG_LEVEL=INFO

# AgentArena Backend Configuration
BACKEND_FINDINGS_ENDPOINT=http://localhost:8080/api/insert-findings
BACKEND_SUBMISSIONS_ENDPOINT=http://localhost:8080/api/submissions
BACKEND_TASK_REPOSITORY_ENDPOINT=http://localhost:8080/api/task-repository
BACKEND_API_KEY=some-secret-key

# Task settings
TASK_ID=TESTTASK
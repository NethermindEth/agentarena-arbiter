# Copy to .env and fill in. Required values are uncommented; the rest show their defaults.
# Leave a setting commented out rather than empty: with docker compose, an empty TRIAGE_WORK_DIR
# would override the image's /var/lib/arbiter-triage and send the triage to /tmp.

# Claude Code (CLI) configuration for evaluation and duplicate merging.
# Use a dedicated, spend-limited key: agents run untrusted repository code (sandboxed).
CLAUDE_API_KEY=sk-ant-your-api-key-here
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=xhigh

# Findings triage. Timeouts, the build agent's network allowlist and the 30-day evidence
# retention are constants in app/core/claude_code_triage.py.
# required: no sandbox, no run. optional: static analysis only on hosts without the sandbox.
# off: never run PoCs.
TRIAGE_POC_MODE=required
# Sandboxes and PoC evidence: outside HOME, the service dir and task data; at most 48 bytes.
# Default <system tmp>/arbiter-triage-<uid>; the Docker image sets /var/lib/arbiter-triage.
TRIAGE_WORK_DIR=/var/lib/arbiter-triage
# Claude Code runs at once across the service, duplicate merges included
TRIAGE_MAX_PARALLEL_AGENTS=4
# Spend cap per claude run; 0 disables it
TRIAGE_AGENT_MAX_BUDGET_USD=10

# Gemini API configuration (deduplication)
GEMINI_API_KEY=AI-your-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_TOKENS=65536
# Used for gemini-3.5-flash; ignored for other models
GEMINI_THINKING_LEVEL=high
# Used for non-thinking models; ignored for gemini-3.5-flash
# GEMINI_TEMPERATURE=0.0

# Application settings
# DEBUG=true keeps every triage agent's sandbox after a run: a full repository copy per agent,
# so it fills the disk quickly. Leave it off outside debugging.
DEBUG=false
LOG_LEVEL=INFO

# AgentArena backend. BACKEND_API_KEY is the shared secret in both directions: sent to the
# backend and required on the arbiter's own endpoints.
BACKEND_API_KEY=some-secret-key
BACKEND_FINDINGS_ENDPOINT=http://localhost:8080/api/insert-findings
BACKEND_TASK_REPOSITORY_ENDPOINT=http://localhost:8080/api/task-repository
BACKEND_APPROVED_TASKS_ENDPOINT=http://localhost:8080/api/arbiter/approved-tasks
BACKEND_TASKS_ENDPOINT=http://localhost:8080/api/arbiter/tasks
